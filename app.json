{
  "expo": {
    "name": "Hoopi",
    "slug": "hoopi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hoopimobile",
    "backgroundColor": "#F8F9FF",
    "primaryColor": "#4816FB",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.saqibvizzexpodevsteam.hoopimobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saqibvizzexpodevsteam.hoopimobile"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FF",
          "image": "./assets/images/hoopi-mark.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6c5a2955-6edc-4760-89aa-4884679fa9ef"
      }
    }
  }
}
